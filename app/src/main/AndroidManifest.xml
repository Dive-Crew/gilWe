<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Vehicle SDK: 기어(P/D) 읽기 → 주행 화면 전환, 도착 후 P단 체크인 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- NaviHelper SDK: 기본 내비에 목적지 설정·안내 시작(ROUTE_SEARCH), 주행·도착 정보 수신(ROUTE), 내비 화면 요청(CUSTOM_MAP) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <!-- TextToSpeech SDK: 차량 음성 합성(Speech Service)으로 이야기 낭독 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 내비 화면 위에 지금 재생 중인 이야기를 헤드업 알림으로 표시 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 위치 × 시간 조립: 차량 GPS 위치·속도로 다음 장소까지 남은 시간을 계산 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 안내 중 내비가 앞에 있어도 길 위가 얼지 않도록 포그라운드 서비스(이야기 낭독 = 미디어 재생) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 내비 화면 위에 길 위 이야기 카드·목적지 칩을 그리는 오버레이 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 앞에 있는 앱이 내비일 때만 오버레이를 띄우기 위해 사용 기록 조회 (설정/appops 로 허용) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 패키지 가시성: 이야기 낭독용 TTS 엔진(차량의 Speech 서비스)을 찾을 수 있게 선언 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".GilweApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_gilwe"
        android:theme="@style/Theme.Gilwe">

        <!-- 주행 중에도 지도+이야기 카드(음성 중심) 화면을 보여야 하므로 DO 선언.
             주행 중에는 앱이 스스로 터치 입력·텍스트 양을 줄인 주행 화면만 노출한다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".voice.TripService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|location" />
    </application>
</manifest>
